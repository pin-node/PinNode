{
  "$schema": "https://raw.githubusercontent.com/pin-node/PinNode/main/tools/pinnode_gen/pinnode-game.schema.json",
  "manifestVersion": 1,
  "ruleset": {
    "id": "rpu-example-machine",
    "title": "rpu-example",
    "name": "RPU ExampleMachine (template)",
    "repo": "RetroPinUpgrade/ExampleMachine",
    "version": "0.0.0",
    "scoringVersion": 1,
    "platform": "bally-35"
  },
  "players": { "max": 4 },
  "achievements": [],
  "stats": [],
  "settings": [
    { "id": "free-play", "index": 0, "name": "Free play", "group": "pricing", "type": "bool", "default": 0,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_FREEPLAY", "eeprom": 101, "variable": "FreePlayMode" } },
    { "id": "ball-save", "index": 1, "name": "Ball save", "group": "game", "type": "enum", "unit": "s",
      "values": [ { "v": 0, "label": "Off" }, { "v": 5, "label": "5 s" }, { "v": 10, "label": "10 s" },
                  { "v": 15, "label": "15 s" }, { "v": 20, "label": "20 s" } ],
      "default": 15, "difficulty": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_BALL_SAVE", "eeprom": 100, "variable": "BallSaveNumSeconds" } },
    { "id": "tilt-warnings", "index": 2, "name": "Tilt warnings", "group": "game", "type": "int", "min": 0, "max": 2,
      "default": 2, "difficulty": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_TILT_WARNINGS", "eeprom": 104, "variable": "MaxTiltWarnings" } },
    { "id": "music-volume", "index": 3, "name": "Music volume", "group": "sound", "type": "int", "min": 0, "max": 10,
      "default": 10, "liveSafe": true, "operatorOnly": false,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_MUSIC_VOLUME", "eeprom": 109, "variable": "MusicVolume" } },
    { "id": "sfx-volume", "index": 4, "name": "Sound effects volume", "group": "sound", "type": "int", "min": 0, "max": 10,
      "default": 10, "liveSafe": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SOUNDFX_VOLUME", "eeprom": 108, "variable": "SoundEffectsVolume" } },
    { "id": "callouts-volume", "index": 5, "name": "Callouts volume", "group": "sound", "type": "int", "min": 0, "max": 10,
      "default": 10, "liveSafe": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_CALLOUTS_VOLUME", "eeprom": 111, "variable": "CalloutsVolume" } },
    { "id": "balls-per-game", "index": 6, "name": "Balls per game", "group": "game", "type": "int", "min": 3, "max": 10,
      "default": 3, "difficulty": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_BALLS_PER_GAME", "eeprom": 106, "variable": "BallsPerGame" } },
    { "id": "tournament-scoring", "index": 7, "name": "Tournament scoring", "group": "game", "type": "bool", "default": 0, "tournamentMode": 1,
      "difficulty": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_TOURNAMENT_MODE", "eeprom": 107, "variable": "TournamentScoring" } },
    { "id": "extra-ball-value", "index": 8, "name": "Extra ball value", "group": "awards", "type": "score",
      "min": 0, "max": 99999990, "step": 10, "default": 20000, "difficulty": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_EXTRA_BALL_VALUE", "eeprom": 160, "variable": "ExtraBallValue" } },
    { "id": "special-value", "index": 9, "name": "Special value", "group": "awards", "type": "score",
      "min": 0, "max": 99999990, "step": 10, "default": 40000, "difficulty": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SPECIAL_VALUE", "eeprom": 164, "variable": "SpecialValue" } },
    { "id": "reset-hold-time", "index": 10, "name": "Credit button hold to reset a game", "group": "game", "type": "enum",
      "values": [ { "v": 0, "label": "0 s" }, { "v": 1, "label": "1 s" }, { "v": 2, "label": "2 s" },
                  { "v": 3, "label": "3 s" }, { "v": 99, "label": "Never" } ],
      "default": 2,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_RESET_DURING_GAME", "eeprom": 118, "variable": "TimeRequiredToResetGame" } },
    { "id": "replay-score-1", "index": 11, "name": "Replay score level 1", "group": "awards", "type": "score",
      "min": 0, "max": 99999990, "step": 10, "default": 1000000,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SCORE_LEVEL_1", "variable": "AwardScores[0]" } },
    { "id": "replay-score-2", "index": 12, "name": "Replay score level 2", "group": "awards", "type": "score",
      "min": 0, "max": 99999990, "step": 10, "default": 3000000,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SCORE_LEVEL_2", "variable": "AwardScores[1]" } },
    { "id": "replay-score-3", "index": 13, "name": "Replay score level 3", "group": "awards", "type": "score",
      "min": 0, "max": 99999990, "step": 10, "default": 5000000,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SCORE_LEVEL_3", "variable": "AwardScores[2]" } },
    { "id": "score-award-replay", "index": 14, "name": "Score levels that award a replay", "group": "awards",
      "type": "flags", "bits": [ { "bit": 0, "label": "Level 1" }, { "bit": 1, "label": "Level 2" },
                                 { "bit": 2, "label": "Level 3" } ],
      "default": 7,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SCORE_AWARDS", "eeprom": 105, "variable": "ScoreAwardReplay" } },
    { "id": "scrolling-scores", "index": 15, "name": "Scrolling scores", "group": "display", "type": "bool", "default": 1,
      "liveSafe": true,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_SCROLLING_SCORES", "eeprom": 110, "variable": "ScrollingScores" } },
    { "id": "coins-per-credit-1", "index": 16, "name": "Coins per credit, chute 1", "group": "pricing", "type": "enum",
      "values": [ { "v": 0, "label": "1 coin / 5 credits" }, { "v": 1, "label": "1 coin / 4 credits" },
                  { "v": 2, "label": "1 coin / 3 credits" }, { "v": 3, "label": "1 coin / 2 credits" },
                  { "v": 4, "label": "1 coin / 1 credit" }, { "v": 5, "label": "2 coins / 3 credits" },
                  { "v": 6, "label": "2 coins / 1 credit" }, { "v": 7, "label": "3 coins / 1 credit" },
                  { "v": 8, "label": "4 coins / 1 credit" } ],
      "default": 4,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_CPC_1", "variable": "CPCSelection[0]" } },
    { "id": "coins-per-credit-2", "index": 17, "name": "Coins per credit, chute 2", "group": "pricing", "type": "enum",
      "values": [ { "v": 0, "label": "1 coin / 5 credits" }, { "v": 1, "label": "1 coin / 4 credits" },
                  { "v": 2, "label": "1 coin / 3 credits" }, { "v": 3, "label": "1 coin / 2 credits" },
                  { "v": 4, "label": "1 coin / 1 credit" }, { "v": 5, "label": "2 coins / 3 credits" },
                  { "v": 6, "label": "2 coins / 1 credit" }, { "v": 7, "label": "3 coins / 1 credit" },
                  { "v": 8, "label": "4 coins / 1 credit" } ],
      "default": 4,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_CPC_2", "variable": "CPCSelection[1]" } },
    { "id": "coins-per-credit-3", "index": 18, "name": "Coins per credit, chute 3", "group": "pricing", "type": "enum",
      "values": [ { "v": 0, "label": "1 coin / 5 credits" }, { "v": 1, "label": "1 coin / 4 credits" },
                  { "v": 2, "label": "1 coin / 3 credits" }, { "v": 3, "label": "1 coin / 2 credits" },
                  { "v": 4, "label": "1 coin / 1 credit" }, { "v": 5, "label": "2 coins / 3 credits" },
                  { "v": 6, "label": "2 coins / 1 credit" }, { "v": 7, "label": "3 coins / 1 credit" },
                  { "v": 8, "label": "4 coins / 1 credit" } ],
      "default": 4,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_CPC_3", "variable": "CPCSelection[2]" } },
    { "id": "match-feature", "index": 19, "name": "Match feature", "group": "features", "type": "bool", "default": 1,
      "source": { "menuId": "OM_BASIC_ADJ_IDS_MATCH_FEATURE", "eeprom": 138, "variable": "MatchFeature" } },
    { "id": "game-rules", "index": 20, "name": "Game rules", "group": "game", "type": "enum",
      "values": [ { "v": 1, "label": "Easy" }, { "v": 2, "label": "Medium" }, { "v": 3, "label": "Hard" },
                  { "v": 4, "label": "Progressive" }, { "v": 5, "label": "Custom" } ],
      "default": 2, "difficulty": true,
      "source": { "eeprom": 137, "variable": "GameRulesSelection" } },
    { "id": "trough-eject-strength", "index": 21, "name": "Trough eject strength", "group": "service", "type": "enum",
      "values": [ { "v": 10, "label": "10" }, { "v": 20, "label": "20" }, { "v": 30, "label": "30" },
                  { "v": 40, "label": "40" }, { "v": 50, "label": "50" }, { "v": 60, "label": "60" } ],
      "default": 10, "requiresPresence": true,
      "source": { "menuId": "OM_GAME_ADJ_TROUGH_EJECT_STRENGTH", "eeprom": 131, "variable": "BallServeSolenoidStrength" } },
    { "id": "saucer-eject-strength", "index": 22, "name": "Saucer eject strength", "group": "service", "type": "int",
      "min": 5, "max": 15, "default": 5, "requiresPresence": true,
      "source": { "menuId": "OM_GAME_ADJ_SAUCER_EJECT_STRENGTH", "eeprom": 134, "variable": "SaucerSolenoidStrength" } }
  ],
  "audits": [
    { "id": "total-plays", "index": 0, "name": "Total plays" },
    { "id": "chute-1-coins", "index": 1, "name": "Chute 1 coins" },
    { "id": "chute-2-coins", "index": 2, "name": "Chute 2 coins" },
    { "id": "chute-3-coins", "index": 3, "name": "Chute 3 coins" },
    { "id": "total-replays", "index": 4, "name": "Total replays" },
    { "id": "high-score-beaten", "index": 5, "name": "High score beaten" }
  ]
}
